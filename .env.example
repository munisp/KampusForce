# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
POSTGRES_URL=             # PostgreSQL 16 connection string (postgresql://user:pass@host:port/db)

# ── Optional local data-platform reference ─────────────────────
KF_ANALYTICS_TOKEN_KEY=   # Local HMAC key, at least 32 characters; never commit a real key
KF_RAY_MODEL_PATH=        # Approved model contract for a separately managed Ray Serve deployment
KF_RAY_SERVE_API_KEY=     # Private serving key, at least 32 characters; never commit a real key

# ── Optional external financial-core gates (disabled by default) ─
KF_ALLOW_LIVE_FINANCIAL_EXECUTION=false
KF_TIGERBEETLE_ADDRESSES=
KF_TIGERBEETLE_CLUSTER_ID=
KF_MOJALOOP_SCHEME_PARTICIPANT_ID=
KF_MOJALOOP_FSP_ID=
KF_MOJALOOP_HUB_ENDPOINT=
KF_MOJALOOP_MTLS_CONFIGURED=false
KF_MOJALOOP_JWS_CONFIGURED=false
KF_MOJALOOP_SETTLEMENT_RECONCILIATION=false

# ── Optional external identity processors (disabled by default) ─
# Keep unset in sandbox. Blank values never enable live identity execution.
KF_IDENTITY_PROCESSOR_MODE=
KF_IDENTITY_PYTHON=
PADDLEOCR_DEVICE=cpu
PADDLEOCR_ENABLE_MKLDNN=false
KF_IDENTITY_TOKENIZATION_SECRET=
KF_VLM_ENDPOINT=
KF_VLM_MODEL=
KF_VLM_API_KEY=
KF_LIVENESS_PROVIDER_MODE=
KF_LIVENESS_PROVIDER_URL=
KF_LIVENESS_PROVIDER_API_KEY=
KF_LIVENESS_PROVIDER_NAME=
KF_DEEPFAKE_PROVIDER_MODE=
KF_DEEPFAKE_PROVIDER_URL=
KF_DEEPFAKE_PROVIDER_API_KEY=
KF_DEEPFAKE_PROVIDER_NAME=
KF_IDENTITY_PROVIDER_ALLOWED_HOSTS=
KF_IDENTITY_PROVIDER_EVALUATION_EVIDENCE=
KF_IDENTITY_LEGAL_SECURITY_APPROVED=false
KF_ALLOW_LIVE_IDENTITY_EXECUTION=false
